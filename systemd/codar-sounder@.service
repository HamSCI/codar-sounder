[Unit]
Description=codar-sounder ionospheric sounder for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
User=codarsnd
Group=codarsnd

WatchdogSec=180
NotifyAccess=main

EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=-/etc/codar-sounder/env/%i.env

WorkingDirectory=/opt/git/sigmond/codar-sounder

# The data lives under <output_dir>/<radiod>/, which the daemon creates as
# codarsnd inside /var/lib/codar-sounder (install.sh owns that to codarsnd).
# No per-%i directory: a reporter-keyed instance (AC0G-B1A) would leave an
# empty one beside the radiod's.
ExecStartPre=+/bin/mkdir -p /var/lib/codar-sounder /var/log/codar-sounder
ExecStartPre=+/usr/bin/chown codarsnd:codarsnd /var/lib/codar-sounder
ExecStartPre=+/usr/bin/chown -R codarsnd:codarsnd /var/log/codar-sounder

# %i names the instance.  Per receiver it is the reporter key (AC0G-B1A):
# --instance %i reads /etc/codar-sounder/AC0G-B1A.toml, whose [instance]
# reporter_id names every row and whose [[radiod]] blocks name that
# receiver's radiod; --radiod-id %i then matches no block and is ignored.
# On a station not yet migrated, %i is a radiod status name, no per-instance
# file exists, and the daemon reads the legacy shared
# /etc/codar-sounder/codar-sounder-config.toml (with a DeprecationWarning),
# where --radiod-id %i picks that radiod's blocks.  --config is omitted on
# purpose: it would win over the per-instance file.
ExecStart=/opt/git/sigmond/codar-sounder/venv/bin/python3 -m codar_sounder.cli daemon \
    --instance %i \
    --radiod-id %i

TimeoutStartSec=60
Restart=always
RestartSec=5

StandardOutput=append:/var/log/codar-sounder/%i.log
StandardError=inherit
SyslogIdentifier=codar-sounder@%i

Nice=5
# One instance now records every [[radiod]] block for its radiod (a560105); 512M held one
# channel but OOM-killed 4 channels at KFS on every first 60 s window (2026-11-10).  2G covers
# a handful of 64 kHz channels until per-channel memory comes down.
MemoryMax=2G
MemorySwapMax=0

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/codar-sounder /var/log/codar-sounder
# The sink: codar.spots and the sigmondb chirp rows (core/sigmondb.py).  The
# "-" lets a host without sigmond or hs-uploader start anyway.
ReadWritePaths=-/var/lib/hs-uploader -/var/lib/sigmond
ReadOnlyPaths=/etc/codar-sounder
PrivateNetwork=false

CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
